{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ayni.dev/contracts/capsule-manifest.v1.schema.json",
  "title": "Ayni Capsule Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "capsule_id",
    "version",
    "kind",
    "owner",
    "tenant_scope",
    "readiness",
    "capabilities",
    "required_capabilities",
    "provided_ports",
    "required_ports",
    "required_capsules",
    "configuration_schema",
    "permissions",
    "required_permissions"
  ],
  "properties": {
    "manifest_version": { "const": 1 },
    "capsule_id": { "$ref": "#/$defs/capsuleId" },
    "version": { "$ref": "#/$defs/version" },
    "kind": {
      "enum": [
        "application",
        "agent",
        "core",
        "harness",
        "model",
        "capability",
        "integration",
        "knowledge",
        "identity",
        "persistence",
        "workflow"
      ]
    },
    "owner": { "type": "string", "minLength": 1, "maxLength": 120 },
    "tenant_scope": { "enum": ["global", "deployment", "tenant"] },
    "readiness": { "enum": ["process", "lazy", "dependency"] },
    "lifecycle": { "enum": ["active", "deprecated"], "default": "active" },
    "deprecation_notice": { "type": "string", "minLength": 1, "maxLength": 500 },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/permission" }
    },
    "required_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/permission" }
    },
    "provided_ports": { "type": "array", "items": { "$ref": "#/$defs/providedPort" } },
    "required_ports": { "type": "array", "items": { "$ref": "#/$defs/requiredPort" } },
    "port_permissions": {
      "type": "object",
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
      "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/permission" } }
    },
    "required_capsules": { "type": "array", "items": { "$ref": "#/$defs/capsuleDependency" } },
    "configuration_schema": {
      "type": "object",
      "required": ["type", "additionalProperties"],
      "properties": {
        "type": { "const": "object" },
        "additionalProperties": { "const": false }
      }
    },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/permission" } },
    "required_permissions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/permission" } }
  },
  "allOf": [
    {
      "if": {
        "properties": { "lifecycle": { "const": "deprecated" } },
        "required": ["lifecycle"]
      },
      "then": { "required": ["deprecation_notice"] },
      "else": { "not": { "required": ["deprecation_notice"] } }
    }
  ],
  "$defs": {
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "capsuleId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "permission": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "providedPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port_id", "contract_version"],
      "properties": {
        "port_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "contract_version": { "$ref": "#/$defs/version" },
        "effect_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["none", "read", "consequential"] }
        }
      }
    },
    "requiredPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port_id", "accepted_versions"],
      "properties": {
        "port_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
        "accepted_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/version" } }
      }
    },
    "capsuleDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capsule_id", "accepted_versions"],
      "properties": {
        "capsule_id": { "$ref": "#/$defs/capsuleId" },
        "accepted_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/version" } }
      }
    }
  }
}
